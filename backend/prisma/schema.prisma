generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PanProviderRecord {
  id         Int    @id @default(autoincrement())
  pan        String @unique
  name       String
  phone      String
  address    String
  holderType String
}

model KycApplication {
  id              Int               @id @default(autoincrement())
  userId          Int
  user            User              @relation(fields: [userId], references: [id])
  pan             String
  name            String
  phone           String
  address         String
  holderType      String
  status          ApplicationStatus @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rejectionReason String?

  phoneOtps    PhoneOtp[]
  kycDocuments KycDocument[]
}

model PhoneOtp {
  id            Int      @id @default(autoincrement())
  applicationId Int
  phone         String
  otp           String
  expiresAt     DateTime
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())

  application KycApplication @relation(fields: [applicationId], references: [id])
}

model KycDocument {
  id            Int          @id @default(autoincrement())
  applicationId Int
  documentType  DocumentType
  fileName      String
  filePath      String
  uploadedAt    DateTime     @default(now())

  application KycApplication @relation(fields: [applicationId], references: [id])
}

enum DocumentType {
  AADHAAR
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  APPROVED
  REJECTED
}

enum Role {
  USER
  ADMIN
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password      String
  phone         String   @unique
  phoneVerified Boolean  @default(false)
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications KycApplication[]
  loginOtp     LoginOtp?
}

model PendingRegistration {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  phone        String   @unique
  otpHash      String
  expiresAt    DateTime
  otpVerified  Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model LoginOtp {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  adminId       Int
  action        String
  applicationId Int
  details       Json?
  createdAt     DateTime @default(now())

  @@index([applicationId])
  @@index([adminId])
}
