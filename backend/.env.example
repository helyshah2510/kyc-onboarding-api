# ============================================
# Backend Environment Configuration Template
# Duplicate this file to .env and customize values.
# NEVER commit real credentials or production secrets.
# ============================================

# Service port
PORT=3004

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kyc_db?schema=public"

# JSON Web Token Secret
# Generate a cryptographically secure key: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-32-byte-secret"
